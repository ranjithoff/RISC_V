create_supply_net VDD
create_supply_net VSS

create_power_domain su -include_scope 
set_domain_supply_net  su -primary_power_net VDD -primary_ground_net VSS

create_supply_port VDD -domain su -direction in
create_supply_port VSS -domain su -direction in

connect_supply_net VDD -ports VDD
connect_supply_net VSS -ports VSS

